{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Completed Upgrades",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"} == 6) or vector(0)",
          "legendFormat": "Completed",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Total Active Upgrades",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"} >= 3) and (hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"} <= 5)) or vector(0)",
          "legendFormat": "Active Upgrades",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "title": "Fleet Upgrade Current State",
      "type": "table",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Phase" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Idle" },
                      "1": { "text": "Installing" },
                      "2": { "text": "Preflight / Pending Schedule" },
                      "3": { "text": "Upgrading Control Plane" },
                      "4": { "text": "Verifying Control Plane" },
                      "5": { "text": "Upgrading NodePools" },
                      "6": { "text": "Completed" },
                      "7": { "text": "Blocked" },
                      "8": { "text": "Paused" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}",
          "legendFormat": "Phase",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "title": "Upgrade Durations (Seconds)",
      "type": "bargauge",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "hypershift_upgrade_duration_seconds{current_version=~\"$current_version\", target_version=~\"$target_version\"} > 0",
          "legendFormat": "{{name}} (Overall)",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "hypershift_upgrade_step_duration_seconds{step=\"ControlPlane\", current_version=~\"$current_version\", target_version=~\"$target_version\"} > 0",
          "legendFormat": "{{name}} (CP Step)",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "title": "Control Plane Component Rollout Statuses",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "hypershift_upgrade_controlplane_component_ready{component!=\"\"} and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}",
          "legendFormat": "{{component}} ready status",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 6,
      "title": "NodePool Upgrade Rollout Ratio Curve",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(hypershift_upgrade_nodepool_rollout_ratio and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}) * 100",
          "legendFormat": "{{namespace}}/{{name}}/{{nodepool}} rollout %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 7,
      "title": "Aggregated Cluster Node Rollout Curve",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(hypershift_upgrade_aggregated_node_rollout_ratio and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}) * 100",
          "legendFormat": "{{namespace}}/{{name}} overall rollout %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "id": 8,
      "title": "Blocked NodePools",
      "description": "Currently blocked NodePools matching the selected upgrade versions. An empty table means no matching blocked pools are reported.",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "hypershift_upgrade_nodepool_blocked{current_version=~\"$current_version\", target_version=~\"$target_version\"} == 1",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9, "title": "Observer Credential Availability", "type": "table",
      "description": "Credential presence and expiry only, not observer authentication. Renewal continues after completion.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_credential_available and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 10, "title": "Guest Access Maintenance Ready", "type": "table",
      "description": "Latest current-generation maintenance result. A failed renewal can coexist with a still-valid credential.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_access_maintenance_ready and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 11, "title": "Latest Guest Purpose Verdict", "type": "table",
      "description": "Purpose-specific evidence, not global health or permission for a future action. Stale/changed plans are explicit; no active verdict for Paused/Completed.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 52},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_assessment{purpose=~\"$guest_purpose\"} and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 12, "title": "Scoped Guest Read Age", "type": "table",
      "description": "Seconds since last successful collection, including unhealthy results. A zero timestamp means never observed, not healthy.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 60},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "(time() - hypershift_upgrade_guest_last_successful_observation_timestamp_seconds) and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 13, "title": "Observer Credential Remaining Lifetime", "type": "table",
      "description": "Seconds until reported token expiration; absent if unknown. Negative means expired.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 60},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "(hypershift_upgrade_guest_credential_expiration_timestamp_seconds - time()) and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 14, "title": "Guest Assessment Blocker Count", "type": "table",
      "description": "All blockers, including details omitted by the 32-entry limit. Zero alone is not a passing assessment.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 68},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_blocker_count and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 15, "title": "Guest Operator Blockers", "type": "table",
      "description": "At most 32 reported blocker details. Removed operators disappear after the next complete snapshot; absence is not proof of health.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 68},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_operator_blocker{purpose=~\"$guest_purpose\"} and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    },
    {
      "id": 16, "title": "Assessed Guest Operator Count", "type": "table",
      "description": "Latest fresh assessment summaries, at most 256. No expected or retained inventory; a failed read may report zero summaries.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 76},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "hypershift_upgrade_guest_operator_count and on(namespace, name) hypershift_upgrade_phase{current_version=~\"$current_version\", target_version=~\"$target_version\"}", "format": "table", "instant": true, "range": false, "refId": "A"}]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hypershift", "operator", "sre"],
  "templating": {
    "list": [
      {
        "name": "guest_purpose", "label": "Guest Purpose", "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(hypershift_upgrade_guest_assessment, purpose)",
        "query": {"query": "label_values(hypershift_upgrade_guest_assessment, purpose)", "refId": "StandardVariableQuery"},
        "includeAll": true, "allValue": ".*", "multi": true, "refresh": 1, "current": {}, "sort": 1
      },
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(hypershift_upgrade_phase, current_version)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "current_version",
        "query": {
          "query": "label_values(hypershift_upgrade_phase, current_version)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(hypershift_upgrade_phase, target_version)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "target_version",
        "query": {
          "query": "label_values(hypershift_upgrade_phase, target_version)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "HyperShift Upgrade Coordinator SRE Dashboard",
  "uid": "huc-sre-dashboard",
  "version": 3
}
